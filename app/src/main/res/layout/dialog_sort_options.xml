<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_sort"
            app:tint="@color/secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Sort Songs By"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#222638" />

    <!-- 1. Title A-Z -->
    <LinearLayout
        android:id="@+id/sortTitleAZ"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Title (A → Z)"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivSortCheckAZ"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star_filled"
            app:tint="@color/secondary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 2. Title Z-A -->
    <LinearLayout
        android:id="@+id/sortTitleZA"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Title (Z → A)"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivSortCheckZA"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star_filled"
            app:tint="@color/secondary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 3. Date Added (Newest) -->
    <LinearLayout
        android:id="@+id/sortDateAdded"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recently Added (Newest First)"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivSortCheckDate"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star_filled"
            app:tint="@color/secondary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 4. Duration (Longest) -->
    <LinearLayout
        android:id="@+id/sortDuration"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Duration (Longest First)"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivSortCheckDuration"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star_filled"
            app:tint="@color/secondary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 5. Artist Name -->
    <LinearLayout
        android:id="@+id/sortArtist"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Artist Name (A → Z)"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivSortCheckArtist"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star_filled"
            app:tint="@color/secondary"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
