<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top Navigation Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_download"
                app:tint="@color/secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Online Music &amp; Download"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseSearchDialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_card_rounded"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </RelativeLayout>

    <!-- Search Input Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/etOnlineSearchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search song, artist, or paste URL..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnClearOnlineSearch"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/text_secondary" />

        <Button
            android:id="@+id/btnSubmitOnlineSearch"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:backgroundTint="@color/primary"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Search"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="17dp" />
    </LinearLayout>

    <!-- Segmented Source Switcher Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:orientation="horizontal">

        <!-- YouTube Segment Tab -->
        <LinearLayout
            android:id="@+id/btnSourceYT"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_card_rounded"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_youtube" />

            <TextView
                android:id="@+id/tvTabYTIssue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="YouTube"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Spotify Segment Tab -->
        <LinearLayout
            android:id="@+id/btnSourceSpotify"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_card_light"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_spotify" />

            <TextView
                android:id="@+id/tvTabSpotifyIssue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Spotify"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Results & Floating Preview Player Container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Results List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOnlineResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/cardOnlinePreviewPlayer"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <!-- Loading State -->
        <LinearLayout
            android:id="@+id/llOnlineLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/secondary" />

            <TextView
                android:id="@+id/tvOnlineLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Searching songs online..."
                android:textColor="@color/secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/llOnlineEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_muted" />

            <TextView
                android:id="@+id/tvOnlineEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No results found"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOnlineEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Try searching for another song title or artist"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Bottom Mini Player (Exact match to local player design with bg_mini_player & bg_circle_button) -->
        <LinearLayout
            android:id="@+id/cardOnlinePreviewPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_mini_player"
            android:elevation="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Direct Mini Seekbar with 20dp touch height and 4.5dp visual track -->
            <SeekBar
                android:id="@+id/sbOnlinePreview"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="-4dp"
                android:layout_marginBottom="-4dp"
                android:maxHeight="4.5dp"
                android:minHeight="4.5dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:progress="0"
                android:progressDrawable="@drawable/bg_mini_seekbar_track"
                android:splitTrack="false"
                android:thumb="@drawable/bg_mini_seekbar_thumb"
                android:thumbOffset="0dp" />

            <!-- Main Content Area: Tapping this opens the Full 8D Player Screen -->
            <RelativeLayout
                android:id="@+id/rlPreviewContentArea"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <!-- Artwork / Icon -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPreviewThumb"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ivPreviewThumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_headphone" />
                </androidx.cardview.widget.CardView>

                <!-- Song Title & Badge Column -->
                <LinearLayout
                    android:id="@+id/llPreviewSongInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="6dp"
                    android:layout_toStartOf="@+id/llPreviewControls"
                    android:layout_toEndOf="@+id/cardPreviewThumb"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPreviewTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Preview Song Title Playing" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPreviewBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card_rounded"
                            android:paddingStart="4dp"
                            android:paddingTop="1dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="1dp"
                            android:text="8D ORBIT"
                            android:textColor="@color/accent_pink"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPreviewTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            tools:text="0:29 / 2:40" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Mini Controls: Prev, Play/Pause, Next, Download, Close -->
                <LinearLayout
                    android:id="@+id/llPreviewControls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Prev Button -->
                    <ImageButton
                        android:id="@+id/btnPreviewPrev"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Previous"
                        android:padding="6dp"
                        android:src="@drawable/ic_prev" />

                    <!-- Play / Pause Gradient Circle Button -->
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp">

                        <ImageButton
                            android:id="@+id/btnPreviewPlayPause"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_button"
                            android:contentDescription="Play/Pause"
                            android:padding="9dp"
                            android:src="@drawable/ic_pause" />

                        <ProgressBar
                            android:id="@+id/pbPreviewPlayerBuffering"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/text_primary"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Next Button -->
                    <ImageButton
                        android:id="@+id/btnPreviewNext"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Next"
                        android:padding="6dp"
                        android:src="@drawable/ic_next" />

                    <!-- Download Option Button (Right beside controls) -->
                    <ImageButton
                        android:id="@+id/btnPreviewDownload"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Download Track"
                        android:padding="6dp"
                        android:src="@drawable/ic_download"
                        app:tint="@color/secondary" />

                    <!-- Close Preview Player -->
                    <ImageButton
                        android:id="@+id/btnPreviewClose"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Close Player"
                        android:padding="5dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/text_muted" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

    </RelativeLayout>
</LinearLayout>
